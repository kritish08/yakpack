# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only. Seed/restore scripts AND the
                                    # admin panel at runtime — required in prod.

# Public origin — used for the password-reset redirect
NEXT_PUBLIC_SITE_URL=https://yakpack.tech

# AI layer (optional). Absent or false => every AI surface is hidden and the
# rule-based Today/Plan experience stays green.
AI_ENABLED=false
OPENAI_API_KEY=                     # server-only; never exposed to the client
OPENAI_MODEL=gpt-5.6-luna           # override to swap models without a deploy
# OPENAI_USE_RESPONSES=false        # fall back to chat completions
# OPENAI_BASE_URL=                  # only for an OpenAI-compatible gateway

# Seed overrides (optional). The template trip's name and departure come from the
# Trip Meta table in docs/01_packing_list_master.md; set these to override that
# file without editing it — which is how a private deployment keeps its own
# details out of a public repo.
#
# Contacts are no longer env vars. They are rows in `trip_contacts`, seeded from
# the Trip Contacts table in the same file and editable at Settings → Contacts.
TRIP_NAME=
TRIP_DEPART_DATE=
