# AI on, but no server key: that is exactly what a normal user sees, so Pemba
# is BYOK-only. Paste a key into Settings to exercise it.
# Set OPENAI_API_KEY here to also test the admin server-key fallback.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
